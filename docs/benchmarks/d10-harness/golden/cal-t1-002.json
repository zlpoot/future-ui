      "type": "state",
      "path": "/select[0]",
      "state": {
        "value": "unsaved"
      }
    },
    {
      "id": "i-sel",
      "type": "interaction",
      "action": {
        "kind": "change",
        "target": "/select[0]",
        "value": "saved"
      },
      "expect": {
        "event": "change",
        "state": {
          "value": "saved"
        }
      }
    }
