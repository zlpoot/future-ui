          "type": "button",
          "disabled": null
        }
      }
    },
    {
      "id": "i-btn",
      "type": "interaction",
      "action": {
        "kind": "click",
        "target": "/button[0]"
      },
      "expect": {
        "event": "click"
      }
    }
  ]
